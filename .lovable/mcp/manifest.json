{
  "version": 1,
  "sdk_version": "0.20.0",
  "path": "/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://hujuqkhbdptsdnbnkslo.supabase.co/auth/v1",
    "require_oauth_client_claim": false,
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "safal-online-mcp",
      "version": "0.1.0",
      "title": "Safal Online Academy MCP"
    },
    "tools": [
      {
        "name": "get_order",
        "title": "Get order",
        "description": "Look up a single order by its order number (e.g. SOA20260704-1234).",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "order_number": {
              "type": "string",
              "minLength": 3,
              "maxLength": 64,
              "description": "Order number to look up."
            }
          },
          "required": [
            "order_number"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "list_recent_orders",
        "title": "List recent orders",
        "description": "List the most recent orders, optionally filtered by status.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50,
              "description": "Number of orders (1-50)."
            },
            "status": {
              "type": "string",
              "enum": [
                "pending",
                "paid",
                "failed",
                "partial_failure"
              ],
              "description": "Optional order status filter."
            }
          },
          "required": [
            "limit"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "get_sales_summary",
        "title": "Get sales summary",
        "description": "Aggregate sales metrics (orders count, revenue) for the last N days.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "days": {
              "type": "integer",
              "minimum": 1,
              "maximum": 90,
              "description": "Look-back window in days (1-90)."
            }
          },
          "required": [
            "days"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      }
    ]
  }
}
